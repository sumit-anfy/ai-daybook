# OKF settings. Copy to `.env` beside server.py (never commit it); the server and
# the web app read it at start. A variable already set in the environment wins,
# so an MCP client config or a systemd unit can override any line.

# ── the corpus ───────────────────────────────────────────────────────────────
# Path to your corpus (a folder with schemas/type-registry.md). Unset: the bundled
# example corpus in examples/corpus. Your project homes (PROJECT_REGISTRY) live in
# that corpus's schemas/type-registry.md, not here.
OKF_ROOT=

# Commit every write to the corpus's git repo (1 = on), and push it (1 = on).
# Async push returns the write at once and pushes in the background.
OKF_GIT_COMMIT=
OKF_GIT_PUSH=
OKF_GIT_PUSH_ASYNC=

# ── the MCP server ───────────────────────────────────────────────────────────
# stdio (default; Claude Desktop / Claude Code spawn the server) or http.
OKF_TRANSPORT=
OKF_HOST=127.0.0.1
OKF_PORT=8765
# The public https URL the server is reached at (OAuth needs it), e.g.
# https://okf.example.com
OKF_PUBLIC_URL=

# Auth — http refuses to start with neither. A static bearer token (scripts,
# Claude Code over http), and/or GitHub OAuth for claude.ai custom connectors.
OKF_AUTH_TOKEN=
OKF_GITHUB_CLIENT_ID=
OKF_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed in. OAuth refuses to start without it.
OKF_GITHUB_ALLOWED_USERS=

# ── the web app (graph explorer + editor) ────────────────────────────────────
OKF_WEB_PASSWORD=
# Cookie-signing secret: openssl rand -hex 32. Required unless OKF_WEB_DEV=1.
OKF_WEB_SECRET=
OKF_WEB_DEV=
# Optional folder of pre-built code-graph HTML files served at /graph/code/<name>.
OKF_CODEGRAPH_DIR=

# ── the reverse proxy (deploy/Caddyfile) ─────────────────────────────────────
OKF_DOMAIN=okf.example.com

# ── auto-deploy (deploy/okf-deploy.sh) ───────────────────────────────────────
# The branch each repo follows (default main for both).
OKF_CODE_BRANCH=
OKF_CORPUS_BRANCH=

# ── the weekly findability run (HTTP mode) ───────────────────────────────────
# A bank of held-out questions for YOUR corpus (format: tests/findability_seed.yaml);
# the bundled bank only measures the example corpus.
OKF_FINDABILITY_BANK=
# The home the run's log note is filed under (default global-os).
OKF_FINDABILITY_PROJECT=

# ── tuning (defaults are fine) ───────────────────────────────────────────────
# 0 = words-only search, never load the embedding model.
OKF_SEMANTIC=
# Embedding model (fastembed name) and where vectors are cached (~/.okf).
OKF_EMB_MODEL=
OKF_EMB_CACHE=
# Optional: id of a node whose RATIFIED_SCOPE block caps a library of case notes
# (see the example corpus's "Complaint case notes" decision). Unset = check off.
OKF_RATIFIED_SCOPE_NODE=
